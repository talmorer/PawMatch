@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Models
@inject IServiceProvider ServiceProvider

<div class="topbar">
    <div class="brand">🐾 PawMatch</div>

    <div class="links">
        <NavLink href="/" class="lnk" Match="NavLinkMatch.All">Home</NavLink>

        @if (ready)
        {
            @if (logged)
            {
                <NavLink href="/addpet" class="lnk">Add Pet</NavLink>
                <NavLink href="/preferences" class="lnk">Preferences</NavLink>
                <NavLink href="/myaccount" class="lnk">My Account</NavLink>

                @if (isAdmin)
                {
                    <NavLink href="/admin" class="lnk">Admin</NavLink>
                }
            }
            else
            {
                <NavLink href="/login" class="lnk">Login</NavLink>
                <NavLink href="/register" class="lnk">Register</NavLink>
            }
        }
    </div>
</div>

<div class="body">
    @Body
</div>

@code {
    bool ready = false;
    bool logged = false;
    bool isAdmin = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));
        var res = await ses.GetAsync<Customer>("customer");

        logged = res.Success && res.Value != null;
        isAdmin = logged && res.Value.IsAdmin;

        ready = true;
        StateHasChanged();
    }
}

<style>
    .topbar {
        height: 60px;
        background: #ffffff;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .brand {
        font-weight: 900;
        color: #2e5f3e;
        font-size: 20px;
    }

    .links {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .lnk {
        text-decoration: none;
        color: #222;
        padding: 8px 12px;
        border-radius: 10px;
        font-weight: 700;
    }

        .lnk.active {
            background: #2e5f3e;
            color: white;
        }

    .body {
        min-height: calc(100vh - 60px);
        background: #f8faf9;
        padding: 25px;
    }
</style>
