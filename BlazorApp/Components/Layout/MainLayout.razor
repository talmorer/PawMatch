@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Models
@inject ProtectedSessionStorage MySession
@inject NavigationManager Nav

<header>
    <div>🐾 PawMatch</div>

    <nav>
        @if (isLoggedIn)
        {
            <a href="/addpet">Add Pet</a>
            <a href="/mypets">My Pets</a>
            <a href="/myaccount">My Account</a>
        }
        else
        {
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        }

        @* Placing Home last so it aligns to the top right corner *@
        <a href="/">Home</a>
    </nav>
</header>

<main>
    @Body
</main>

@code {
    private bool isLoggedIn = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Check if user is logged in to toggle navigation links
                var res = await MySession.GetAsync<Customer>("customer");
                if (res.Success && res.Value != null)
                {
                    isLoggedIn = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // Silently handle exceptions during prerendering
            }
        }
    }
}

<style>
    /* Styling completely based on HTML tags, no classes used */
    header {
        height: 60px;
        background: #ffffff;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        position: sticky;
        top: 0;
        z-index: 5;
        font-family: 'Segoe UI', sans-serif;
    }

        header > div {
            font-weight: 900;
            color: #2e5f3e;
            font-size: 20px;
        }

        header > nav {
            display: flex;
            gap: 15px;
            align-items: center;
        }

            header > nav > a {
                text-decoration: none;
                color: #222;
                padding: 8px 12px;
                border-radius: 10px;
                font-weight: 700;
                cursor: pointer;
                transition: background 0.2s, color 0.2s;
            }

                header > nav > a:hover {
                    background: #2e5f3e;
                    color: white;
                }

    main {
        min-height: calc(100vh - 60px);
        background: #f8faf9;
        padding: 25px;
        font-family: 'Segoe UI', sans-serif;
    }
</style>