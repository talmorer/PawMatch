@page "/myapplications"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager nav

<div class="applications-container">
    @if (!loaded)
    {
        <div class="status-box">Loading your applications...</div>
    }
    else
    {
        <main class="content-card">
            <div class="page-header">
                <h2 class="logo">🐾 PawMatch</h2>
                <h3>My Applications</h3>
                <p>Track the status of the pets you want to adopt</p>
            </div>

            @if (myRequests == null || myRequests.Count == 0)
            {
                <div class="empty-state">
                    <p>You haven't submitted any adoption requests yet.</p>
                    <button class="btn btn-primary" @onclick="GoToSearch">Find a Pet</button>
                </div>
            }
            else
            {
                <div class="requests-list">
                    @foreach (var req in myRequests)
                    {
                        <div class="request-item">
                            <div class="request-info">
                                <h4>Pet Name: @req.PetName</h4>
                                <p><b>Date Requested:</b> @req.RequestDate</p>
                            </div>

                            <div class="request-status">
                                @if (req.IsAdopted == 1)
                                {
                                    <span class="badge approved">Approved 🎉</span>
                                    <p class="small-text">The owner approved your request! Check your email for contact details.</p>
                                }
                                else if (req.IsAdopted == 2)
                                {
                                    <span class="badge rejected">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge pending">Pending</span>
                                    <p class="small-text">Waiting for the owner's response.</p>
                                }
                            </div>
                        </div>
                    }
                </div>
                <button class="btn btn-back" @onclick="GoBack">Back to My Account</button>
            }
        </main>
    }
</div>

@code {
    private Customer user = new Customer();
    private List<AdoptionRequest> myRequests = new List<AdoptionRequest>();
    private bool loaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var res = await MySession.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login");
            return;
        }

        user = res.Value;

        AdoptionRequestDB db = new AdoptionRequestDB();
        myRequests = await db.GetRequestsByAdopterAsync(user.UserID);

        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private void GoBack()
    {
        nav.NavigateTo("/myaccount");
    }

    private void GoToSearch()
    {
        nav.NavigateTo("/");
    }
}

<style>
    .applications-container {
        display: flex;
        justify-content: center;
        min-height: 100vh;
        background-color: #f8faf9;
        padding: 40px 20px;
    }

    .content-card {
        width: 100%;
        max-width: 650px;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 30px;
    }

        .page-header .logo {
            color: #2e5f3e;
            margin: 0;
            font-size: 1.8rem;
            font-weight: bold;
        }

        .page-header h3 {
            margin: 10px 0 5px 0;
            color: #333;
            font-size: 1.5rem;
        }

        .page-header p {
            margin: 0;
            color: #777;
            font-size: 0.95rem;
        }

    .requests-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .request-item {
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #fdfdfd;
    }

    .request-info h4 {
        margin: 0 0 8px 0;
        color: #2e5f3e;
        font-size: 1.2rem;
    }

    .request-info p {
        margin: 4px 0;
        font-size: 0.95rem;
        color: #555;
    }

    .request-status {
        text-align: right;
        max-width: 200px;
    }

    .badge {
        display: inline-block;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9rem;
        color: white;
        margin-bottom: 8px;
    }

    .approved {
        background-color: #2e5f3e;
    }

    .rejected {
        background-color: #d93025;
    }

    .pending {
        background-color: #e67e22;
    }

    .small-text {
        font-size: 0.8rem;
        color: #777;
        margin: 0;
        line-height: 1.3;
    }

    .btn {
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-primary {
        background-color: #2e5f3e;
        color: white;
        margin-top: 20px;
    }

    .btn-back {
        background-color: #eee;
        color: #333;
        margin-top: 25px;
        width: 100%;
        font-size: 1rem;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #888;
    }

    @@media (max-width: 600px) {
        .request-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .request-status {
            text-align: left;
            max-width: 100%;
        }
    }
</style>