@page "/myaccount"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IServiceProvider ServiceProvider

<div>
    @if (!loaded)
    {
        <p>Loading...</p>
    }
    else
    {
        <main>
            <header>
                <h2>🐾 PawMatch</h2>
                <h3>My Account</h3>
            </header>

            <section>
                <h4>Profile</h4>

                @if (!isEditing)
                {
                    <p><b>First Name:</b> @user.FirstName</p>
                    <p><b>Last Name:</b> @user.LastName</p>
                    <p><b>Email:</b> @user.Email</p>
                    <p><b>Phone:</b> @user.Phone</p>

                    <div>
                        <button type="button" @onclick="StartEdit" disabled="@working">Edit Details</button>
                        <button type="button" @onclick="Logout" disabled="@working">Logout</button>

                        @if (user.IsAdmin)
                        {
                            <button type="button" @onclick="GoAdmin" disabled="@working">Go to Admin Panel</button>
                        }
                    </div>
                }
                else
                {
                    <input type="text" @bind="user.FirstName" placeholder="First name" disabled="@working" />
                    <input type="text" @bind="user.LastName" placeholder="Last name" disabled="@working" />
                    <input type="text" @bind="user.Phone" placeholder="Phone" disabled="@working" />
                    <input type="password" @bind="user.Password" placeholder="Password" disabled="@working" />

                    <div>
                        <button type="button" @onclick="UpdateUser" disabled="@working">Save Profile</button>
                        <button type="button" @onclick="CancelEdit" disabled="@working">Cancel</button>
                    </div>
                }
            </section>

            <section>
                <h4>Preferences</h4>

                @* Changed to value and @onchange to correctly trigger the race loading *@
                <select value="@typeID" @onchange="OnTypeChange" disabled="@working">
                    <option value="0">No preference (All Types)</option>
                    @foreach (var t in types)
                    {
                        <option value="@t.TypeID">@t.Description</option>
                    }
                </select>

                <select @bind="raceID" disabled="@(IsRaceDisabled() || working)">
                    <option value="0">No preference (All Races)</option>
                    @foreach (var r in races)
                    {
                        <option value="@r.PetRaceID">@r.Description</option>
                    }
                </select>

                <fieldset>
                    <legend>Preferred Traits</legend>
                    <div>
                        @foreach (var tr in traits)
                        {
                            <label>
                                <input type="checkbox" checked="@selTraits.Contains(tr.TraitID)" disabled="@working"
                                       @onchange="(e) => ToggleTrait(tr.TraitID, e)" />
                                <span>@tr.TraitName</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <button type="button" @onclick="SavePrefs" disabled="@working">Save Preferences</button>

                @if (msg != "")
                {
                    <span>@msg</span>
                }
            </section>

            <section>
                <h4>Quick Links</h4>
                <a href="/mypets">My Pets</a>
                <a href="/">Home</a>
            </section>
        </main>
    }
</div>

@code {
    private ProtectedSessionStorage ses;
    private NavigationManager nav;

    // Manual instantiation of objects
    private Customer user = new Customer();
    private List<PetType> types = new List<PetType>();
    private List<PetRace> races = new List<PetRace>();
    private List<Trait> traits = new List<Trait>();
    private List<int> selTraits = new List<int>();

    private bool loaded = false;
    private bool isEditing = false;
    private bool working = false;

    private int typeID = 0;
    private int raceID = 0;
    private string msg = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));

        var res = await ses.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login", true);
            return;
        }

        user = res.Value;

        PetTypeDB tdb = new PetTypeDB();
        types = await tdb.GetAllAsync();

        PetTraitsDB trdb = new PetTraitsDB();
        traits = await trdb.GetAllAsync();

        await LoadPrefs();

        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPrefs()
    {
        UserPrefsDB pdb = new UserPrefsDB();
        var pr = await pdb.GetPrefsAsync(user.UserID);

        if (pr != null)
        {
            typeID = pr.PrefTypeID;
            raceID = pr.PrefRaceID;
        }
        else
        {
            typeID = 0;
            raceID = 0;
        }

        await LoadRacesByType();

        selTraits = new List<int>();
        UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
        var lst = await utdb.GetByUserAsync(user.UserID);

        foreach (var x in lst)
        {
            selTraits.Add(x.TraitID);
        }

        await ses.SetAsync("prefs", new UserPrefs { UserID = user.UserID, CanAdopt = 0, CanUpload = 0, PrefTypeID = typeID, PrefRaceID = raceID });
        await ses.SetAsync("prefsTraits", selTraits);
    }

    private bool IsRaceDisabled()
    {
        if (typeID == 0) return true;
        if (races == null) return true;
        return races.Count == 0;
    }

    // Manual onchange event handler to fix the select dropdown issue
    private async Task OnTypeChange(ChangeEventArgs e)
    {
        if (working) return;

        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            typeID = val;
            raceID = 0; // Reset race selection when type changes
            await LoadRacesByType();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadRacesByType()
    {
        races = new List<PetRace>();
        if (typeID == 0) return;

        PetRaceDB rdb = new PetRaceDB();
        races = await rdb.GetByTypeAsync(typeID);
    }

    private void ToggleTrait(int id, ChangeEventArgs e)
    {
        bool v = false;
        if (e != null && e.Value != null)
        {
            if (e.Value is bool)
                v = (bool)e.Value;
            else
                v = e.Value.ToString() == "true";
        }

        if (v)
        {
            if (!selTraits.Contains(id))
                selTraits.Add(id);
        }
        else
        {
            selTraits.Remove(id);
        }
    }

    private async Task SavePrefs()
    {
        if (working) return;
        try
        {
            working = true;
            msg = "Saving...";
            await InvokeAsync(StateHasChanged);

            UserPrefs p = new UserPrefs
            {
                UserID = user.UserID,
                CanAdopt = 0,
                CanUpload = 0,
                PrefTypeID = typeID,
                PrefRaceID = raceID
            };

            UserPrefsDB pdb = new UserPrefsDB();
            await pdb.SavePrefsAsync(p);

            UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
            await utdb.DeleteByUserAsync(user.UserID);

            foreach (int tid in selTraits)
            {
                await utdb.InsertAsync(user.UserID, tid);
            }

            await ses.SetAsync("prefs", p);
            await ses.SetAsync("prefsTraits", selTraits);

            msg = "Preferences Saved!";
        }
        catch (Exception ex)
        {
            msg = "Save failed: " + ex.Message;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartEdit() => isEditing = true;
    private void CancelEdit() => isEditing = false;

    private async Task UpdateUser()
    {
        if (working) return;
        try
        {
            working = true;
            CustomerDB db = new CustomerDB();
            await db.UpdateAsync(user);

            await ses.SetAsync("customer", user);
            isEditing = false;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Logout()
    {
        await ses.DeleteAsync("customer");
        await ses.DeleteAsync("prefs");
        await ses.DeleteAsync("prefsTraits");
        nav.NavigateTo("/login", true);
    }

    private void GoAdmin()
    {
        nav.NavigateTo("/admin", true);
    }
}

<style>
    /* Styling exclusively based on tags to meet the rigid separation requirement */
    div > main {
        max-width: 600px;
        margin: 40px auto;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        font-family: 'Segoe UI', sans-serif;
    }

    main > header {
        text-align: center;
        margin-bottom: 30px;
    }

        main > header > h2 {
            color: #2e5f3e;
            margin: 0 0 5px 0;
        }

        main > header > h3 {
            margin: 0;
            font-weight: 800;
            color: #333;
        }

    main > section {
        margin-top: 25px;
        padding: 20px;
        border: 1px solid #eee;
        border-radius: 16px;
        background: #fdfdfd;
    }

        main > section > h4 {
            font-weight: 900;
            color: #2e5f3e;
            margin: 0 0 15px 0;
            font-size: 1.2rem;
        }

        main > section > p {
            margin: 8px 0;
            color: #444;
        }

        main > section > input,
        main > section > select {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 10px;
            box-sizing: border-box;
            font: inherit;
            background: white;
        }

            main > section > select:disabled {
                background-color: #f1f1f1;
                color: #888;
                cursor: not-allowed;
            }

        main > section > div > button,
        main > section > button {
            width: 100%;
            background-color: #2e5f3e;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            margin-top: 10px;
            font-weight: bold;
            transition: opacity 0.2s;
        }

            main > section > div > button:nth-of-type(2) {
                background-color: #777; /* Logout or Cancel button */
            }

            main > section > div > button:nth-of-type(3) {
                background-color: #2e7d9f; /* Go to Admin button */
            }

            main > section > div > button:disabled,
            main > section > button:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        main > section > span {
            display: block;
            margin-top: 15px;
            font-weight: bold;
            text-align: center;
            color: #2e5f3e;
            background-color: #eef5f0;
            padding: 10px;
            border-radius: 8px;
        }

        main > section > fieldset {
            margin-top: 15px;
            padding: 15px;
            border: 1px solid #e9e9e9;
            border-radius: 14px;
            background: #fff;
        }

            main > section > fieldset > legend {
                font-weight: bold;
                color: #2e5f3e;
                padding: 0 8px;
            }

            main > section > fieldset > div {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

                main > section > fieldset > div > label {
                    display: flex;
                    gap: 10px;
                    align-items: center;
                    padding: 10px;
                    border-radius: 12px;
                    background: #fbfbfb;
                    border: 1px solid #eee;
                    font-weight: 700;
                    cursor: pointer;
                    color: #333;
                }

        main > section > a {
            display: inline-block;
            margin-right: 10px;
            margin-top: 10px;
            padding: 12px 20px;
            border-radius: 12px;
            background: #eef5f0;
            border: 1px solid #dcece1;
            color: #2e5f3e;
            text-decoration: none;
            font-weight: bold;
            transition: background 0.2s;
        }

            main > section > a:hover {
                background: #e0ece4;
            }
</style>