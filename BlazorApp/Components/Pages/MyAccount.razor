@page "/myaccount"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IServiceProvider ServiceProvider

<div class="account-container">
    @if (!loaded)
    {
        <div class="card">
            <p class="info">Loading...</p>
        </div>
    }
    else if (user == null)
    {
        <div class="card">
            <p class="error">❌ You are not logged in.</p>
            <button class="btn" @onclick="GoLogin">Go to Login</button>
        </div>
    }
    else
    {
        <div class="card">
            <h2 class="logo">🐾 PawMatch</h2>
            <h3>Welcome, @user.FirstName!</h3>

            @if (!isEditing)
            {
                <p><b>First Name:</b> @user.FirstName</p>
                <p><b>Last Name:</b> @user.LastName</p>
                <p><b>Email:</b> @user.Email</p>
                <p><b>Phone:</b> @user.Phone</p>

                <button class="btn" @onclick="GoMyPets">My Pets</button>
                <button class="btn" @onclick="() => isEditing = true">Edit Details</button>
                <button class="btn gray" @onclick="Logout">Logout</button>

                @if (user.IsAdmin)
                {
                    <button class="btn blue" @onclick="GoAdmin">Go to Admin Panel</button>
                }
            }
            else
            {
                <input class="input" @bind="user.FirstName" placeholder="First name" />
                <input class="input" @bind="user.LastName" placeholder="Last name" />
                <input class="input" @bind="user.Phone" placeholder="Phone" />
                <input class="input" type="password" @bind="user.Password" placeholder="Password" />

                <button class="btn" @onclick="UpdateUser">Save</button>
                <button class="btn gray" @onclick="CancelEdit">Cancel</button>
            }

            <p class="msg">@msg</p>
        </div>
    }
</div>

@code {
    ProtectedSessionStorage ses;
    NavigationManager nav;

    Customer user;
    bool loaded = false;
    bool isEditing = false;

    string msg = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));

        var result = await ses.GetAsync<Customer>("customer");
        if (result.Success && result.Value != null)
        {
            user = result.Value;
        }
        else
        {
            user = null;
        }

        loaded = true;
        StateHasChanged();
    }

    void GoLogin()
    {
        nav.NavigateTo("/login");
    }

    void GoMyPets()
    {
        nav.NavigateTo("/mypets");
    }

    void GoAdmin()
    {
        nav.NavigateTo("/admin");
    }

    async Task UpdateUser()
    {
        msg = "";

        CustomerDB db = new CustomerDB();
        await db.UpdateAsync(user);

        isEditing = false;
        msg = "Saved.";
    }

    void CancelEdit()
    {
        msg = "";
        isEditing = false;
    }

    async Task Logout()
    {
        await ses.DeleteAsync("customer");
        nav.NavigateTo("/login");
    }
}

<style>
    .account-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: calc(100vh - 60px);
        background: #f8faf9;
    }

    .card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        width: 360px;
        text-align: center;
    }

    .logo {
        color: #2e5f3e;
        margin-bottom: 18px;
    }

    .input {
        width: 100%;
        padding: 10px;
        margin: 8px 0;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .btn {
        width: 100%;
        background-color: #2e5f3e;
        color: white;
        padding: 10px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        font-weight: 800;
        box-sizing: border-box;
    }

        .btn.gray {
            background-color: #777;
        }

        .btn.blue {
            background-color: #2e7d9f;
        }

    .msg {
        margin-top: 12px;
        font-weight: 800;
        min-height: 18px;
    }

    .info {
        font-weight: 800;
        color: #333;
    }

    .error {
        color: red;
        font-weight: 800;
    }
</style>
