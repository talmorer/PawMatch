@page "/myaccount"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager nav

<div class="account-page-wrapper">
    @if (!loaded)
    {
        <div class="loading-state">Loading...</div>
    }
    else
    {
        <main class="account-card">
            <header>
                <h2 class="brand-logo">🐾 PawMatch</h2>
                <h3>My Account</h3>
            </header>

            <section class="info-section">
                <h4>Profile Information</h4>

                @if (!isEditing)
                {
                    <div class="display-data">
                        <p><b>First Name:</b> @user.FirstName</p>
                        <p><b>Last Name:</b> @user.LastName</p>
                        <p><b>Email:</b> @user.Email</p>
                        <p><b>Phone:</b> @user.Phone</p>
                    </div>

                    <div class="action-buttons">
                        <button type="button" class="btn btn-primary" @onclick="StartEdit" disabled="@working">Edit Details</button>
                        <button type="button" class="btn btn-secondary" @onclick="Logout" disabled="@working">Logout</button>

                        @if (user.IsAdmin)
                        {
                            <button type="button" class="btn btn-info" @onclick="GoAdmin" disabled="@working">Admin Panel</button>
                        }
                    </div>
                }
                else
                {
                    <div class="edit-form">
                        <label>First Name:</label>
                        <input type="text" @bind="user.FirstName" class="form-control" />

                        <label>Last Name:</label>
                        <input type="text" @bind="user.LastName" class="form-control" />

                        <label>Email:</label>
                        <input type="text" @bind="user.Email" class="form-control" />

                        <label>Phone:</label>
                        <input type="text" @bind="user.Phone" class="form-control" />

                        <label>Password:</label>
                        <input type="password" @bind="user.Password" class="form-control" />

                        <div class="action-buttons">
                            <button type="button" class="btn btn-primary" @onclick="UpdateUser" disabled="@working">Save Profile</button>
                            <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@working">Cancel</button>
                        </div>
                    </div>
                }

                @if (profileMsg != "")
                {
                    <div class="error-alert">@profileMsg</div>
                }
            </section>

            <section class="info-section">
                <h4>Matching Preferences</h4>

                <label>Preferred Pet Type:</label>
                <select value="@typeID" @onchange="OnTypeChange" class="form-control" disabled="@working">
                    <option value="0">No preference (All Types)</option>
                    @foreach (var t in types)
                    {
                        <option value="@t.TypeID">@t.Description</option>
                    }
                </select>

                <label>Preferred Race:</label>
                <select @bind="raceID" class="form-control" disabled="@(IsRaceDisabled() || working)">
                    <option value="0">No preference (All Races)</option>
                    @foreach (var r in races)
                    {
                        <option value="@r.PetRaceID">@r.Description</option>
                    }
                </select>

                <fieldset class="traits-box">
                    <legend>Preferred Traits</legend>
                    <div class="traits-list">
                        @foreach (var tr in traits)
                        {
                            <label class="trait-checkbox">
                                <input type="checkbox" checked="@selTraits.Contains(tr.TraitID)" disabled="@working"
                                       @onchange="(e) => ToggleTrait(tr.TraitID, e)" />
                                <span>@tr.TraitName</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <button type="button" class="btn btn-primary full-width" @onclick="SavePrefs" disabled="@working">Save Preferences</button>

                @if (prefsMsg != "")
                {
                    <div class="status-alert">@prefsMsg</div>
                }
            </section>

            <section class="links-section">
                <h4>Quick Links</h4>
                <div class="nav-links">
                    <a href="/mypets">My Pets</a>
                    <a href="/">Home</a>
                </div>
            </section>
        </main>
    }
</div>

@code {
    private Customer user = new Customer();
    private List<PetType> types = new List<PetType>();
    private List<PetRace> races = new List<PetRace>();
    private List<Trait> traits = new List<Trait>();
    private List<int> selTraits = new List<int>();

    private bool loaded = false;
    private bool isEditing = false;
    private bool working = false;

    private int typeID = 0;
    private int raceID = 0;
    private string profileMsg = "";
    private string prefsMsg = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var res = await MySession.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login", true);
            return;
        }

        user = res.Value;

        PetTypeDB tdb = new PetTypeDB();
        types = await tdb.GetAllAsync();

        PetTraitsDB trdb = new PetTraitsDB();
        traits = await trdb.GetAllAsync();

        await LoadPrefs();

        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPrefs()
    {
        UserPrefsDB pdb = new UserPrefsDB();
        var pr = await pdb.GetPrefsAsync(user.UserID);

        if (pr != null)
        {
            typeID = pr.PrefTypeID;
            raceID = pr.PrefRaceID;
        }

        await LoadRacesByType();

        selTraits = new List<int>();
        UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
        var lst = await utdb.GetByUserAsync(user.UserID);
        foreach (var x in lst) { selTraits.Add(x.TraitID); }
    }

    private async Task OnTypeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            typeID = val;
            raceID = 0;
            await LoadRacesByType();
        }
    }

    private async Task LoadRacesByType()
    {
        races = new List<PetRace>();
        if (typeID == 0) return;
        PetRaceDB rdb = new PetRaceDB();
        races = await rdb.GetByTypeAsync(typeID);
    }

    private bool IsRaceDisabled() => typeID == 0 || races == null || races.Count == 0;

    private void ToggleTrait(int id, ChangeEventArgs e)
    {
        bool v = (bool)e.Value;
        if (v) { if (!selTraits.Contains(id)) selTraits.Add(id); }
        else { selTraits.Remove(id); }
    }

    private async Task SavePrefs()
    {
        working = true;
        prefsMsg = "Saving...";
        try
        {
            UserPrefs p = new UserPrefs { UserID = user.UserID, PrefTypeID = typeID, PrefRaceID = raceID };
            UserPrefsDB pdb = new UserPrefsDB();
            await pdb.SavePrefsAsync(p);

            UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
            await utdb.DeleteByUserAsync(user.UserID);
            foreach (int tid in selTraits) { await utdb.InsertAsync(user.UserID, tid); }

            prefsMsg = "Preferences Saved!";
        }
        catch { prefsMsg = "Error saving."; }
        finally { working = false; }
    }

    private void StartEdit() { isEditing = true; profileMsg = ""; }
    private void CancelEdit() { isEditing = false; profileMsg = ""; }

    private async Task UpdateUser()
    {
        profileMsg = "";

        if (string.IsNullOrWhiteSpace(user.FirstName) || string.IsNullOrWhiteSpace(user.LastName) ||
            string.IsNullOrWhiteSpace(user.Email) || string.IsNullOrWhiteSpace(user.Phone) ||
            string.IsNullOrWhiteSpace(user.Password))
        {
            profileMsg = "Please fill in all fields.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(user.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            profileMsg = "Invalid email format.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(user.Phone, @"^\d{10}$"))
        {
            profileMsg = "Phone must be exactly 10 digits.";
            return;
        }

        working = true;
        try
        {
            CustomerDB db = new CustomerDB();
            await db.UpdateAsync(user);
            await MySession.SetAsync("customer", user);
            isEditing = false;
            profileMsg = "Success!";
        }
        catch { profileMsg = "Update failed."; }
        finally { working = false; }
    }

    private async Task Logout()
    {
        await MySession.DeleteAsync("customer");
        nav.NavigateTo("/login", true);
    }

    private void GoAdmin() => nav.NavigateTo("/admin", true);
}

<style>
    .account-page-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
        background-color: #f8faf9;
        padding: 40px 20px;
    }

    .account-card {
        width: 100%;
        max-width: 600px;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    header {
        text-align: center;
        margin-bottom: 30px;
    }

    .brand-logo {
        color: #2e5f3e;
        margin-bottom: 5px;
    }

    .info-section {
        margin-top: 25px;
        padding: 20px;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        background: #fdfdfd;
    }

    h4 {
        color: #2e5f3e;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
        margin-top: 0;
    }

    label {
        display: block;
        font-weight: bold;
        font-size: 0.9rem;
        margin-top: 15px;
        color: #555;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        color: white;
    }

    .btn-primary {
        background-color: #2e5f3e;
    }

    .btn-secondary {
        background-color: #888;
    }

    .btn-info {
        background-color: #2e7d9f;
    }

    .full-width {
        width: 100%;
        margin-top: 20px;
    }

    .traits-box {
        border: 1px solid #eee;
        border-radius: 8px;
        margin-top: 20px;
        padding: 15px;
    }

    .traits-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .trait-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .error-alert {
        color: #d93025;
        margin-top: 15px;
        font-weight: bold;
        text-align: center;
    }

    .status-alert {
        color: #2e5f3e;
        margin-top: 15px;
        font-weight: bold;
        text-align: center;
    }

    .nav-links {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

        .nav-links a {
            text-decoration: none;
            color: #2e5f3e;
            font-weight: bold;
            background: #eef5f0;
            padding: 8px 15px;
            border-radius: 6px;
        }
</style>