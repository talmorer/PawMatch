@page "/myaccount"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IServiceProvider ServiceProvider

@if (!loaded)
{
    <p>Loading...</p>
}
else
{
    <div class="account-container">
        <div class="card">
            <h2 class="logo">🐾 PawMatch</h2>
            <h3 class="title">My Account</h3>

            <div class="sec">
                <div class="secTitle">Profile</div>

                @if (!isEditing)
                {
                    <p><b>First Name:</b> @user.FirstName</p>
                    <p><b>Last Name:</b> @user.LastName</p>
                    <p><b>Email:</b> @user.Email</p>
                    <p><b>Phone:</b> @user.Phone</p>

                    <button class="btn" @onclick="StartEdit" disabled="@working">Edit Details</button>
                    <button class="btn gray" @onclick="Logout" disabled="@working">Logout</button>

                    @if (user.IsAdmin)
                    {
                        <button class="btn blue" @onclick="GoAdmin" disabled="@working">Go to Admin Panel</button>
                    }
                }
                else
                {
                    <input class="input" @bind="user.FirstName" placeholder="First name" disabled="@working" />
                    <input class="input" @bind="user.LastName" placeholder="Last name" disabled="@working" />
                    <input class="input" @bind="user.Phone" placeholder="Phone" disabled="@working" />
                    <input class="input" type="password" @bind="user.Password" placeholder="Password" disabled="@working" />

                    <button class="btn" @onclick="UpdateUser" disabled="@working">Save</button>
                    <button class="btn gray" @onclick="CancelEdit" disabled="@working">Cancel</button>
                }
            </div>

            <div class="sec">
                <div class="secTitle">Preferences</div>

                <select class="input" @bind="typeID" @bind:after="TypeChanged" disabled="@working">
                    <option value="0">No preference (All Types)</option>
                    @foreach (var t in types)
                    {
                        <option value="@t.TypeID">@t.Description</option>
                    }
                </select>

                <select class="input" @bind="raceID" disabled="@IsRaceDisabled() || working">
                    <option value="0">No preference (All Races)</option>
                    @foreach (var r in races)
                    {
                        <option value="@r.PetRaceID">@r.Description</option>
                    }
                </select>

                <div class="traitsBox">
                    <div class="traitsTitle">Preferred Traits</div>

                    <div class="traitsGrid">
                        @foreach (var tr in traits)
                        {
                            <label class="trItem">
                                <input type="checkbox" checked="@selTraits.Contains(tr.TraitID)" disabled="@working"
                                       @onchange="(e) => ToggleTrait(tr.TraitID, e)" />
                                <span>@tr.TraitName</span>
                            </label>
                        }
                    </div>
                </div>

                <button class="btn" @onclick="SavePrefs" disabled="@working">Save Preferences</button>

                <p class="msg">@msg</p>
            </div>

            <div class="sec">
                <div class="secTitle">Quick Links</div>
                <a class="lnk" href="/mypets">My Pets</a>
                <a class="lnk" href="/">Home</a>
            </div>
        </div>
    </div>
}

@code {
    ProtectedSessionStorage ses;
    NavigationManager nav;

    Customer user;
    bool loaded = false;

    bool isEditing = false;
    bool working = false;

    List<PetType> types = new();
    List<PetRace> races = new();

    List<Trait> traits = new();
    List<int> selTraits = new();

    int typeID = 0;
    int raceID = 0;

    string msg = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));

        var res = await ses.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login", true);
            return;
        }

        user = res.Value;

        PetTypeDB tdb = new PetTypeDB();
        types = await tdb.GetAllAsync();

        PetTraitsDB trdb = new PetTraitsDB();
        traits = await trdb.GetAllAsync();

        await LoadPrefs();

        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadPrefs()
    {
        UserPrefsDB pdb = new UserPrefsDB();
        var pr = await pdb.GetPrefsAsync(user.UserID);

        if (pr != null)
        {
            typeID = pr.PrefTypeID;
            raceID = pr.PrefRaceID;
        }
        else
        {
            typeID = 0;
            raceID = 0;
        }

        await LoadRacesByType();

        selTraits = new();
        UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
        var lst = await utdb.GetByUserAsync(user.UserID);
        foreach (var x in lst)
            selTraits.Add(x.TraitID);

        await ses.SetAsync("prefs", new UserPrefs { UserID = user.UserID, CanAdopt = 0, CanUpload = 0, PrefTypeID = typeID, PrefRaceID = raceID });
        await ses.SetAsync("prefsTraits", selTraits);
    }

    bool IsRaceDisabled()
    {
        if (typeID == 0) return true;
        if (races == null) return true;
        return races.Count == 0;
    }

    async Task TypeChanged()
    {
        raceID = 0;
        await LoadRacesByType();
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadRacesByType()
    {
        races = new();
        if (typeID == 0) return;

        PetRaceDB rdb = new PetRaceDB();
        races = await rdb.GetByTypeAsync(typeID);
    }

    void ToggleTrait(int id, ChangeEventArgs e)
    {
        bool v = false;

        if (e != null && e.Value != null)
        {
            if (e.Value is bool)
                v = (bool)e.Value;
            else
                v = e.Value.ToString() == "true";
        }

        if (v)
        {
            if (!selTraits.Contains(id))
                selTraits.Add(id);
        }
        else
        {
            selTraits.Remove(id);
        }
    }

    async Task SavePrefs()
    {
        if (working) return;

        try
        {
            working = true;
            msg = "Saving...";
            await InvokeAsync(StateHasChanged);

            UserPrefs p = new UserPrefs
            {
                UserID = user.UserID,
                CanAdopt = 0,
                CanUpload = 0,
                PrefTypeID = typeID,
                PrefRaceID = raceID
            };

            UserPrefsDB pdb = new UserPrefsDB();
            await pdb.SavePrefsAsync(p);

            UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
            await utdb.DeleteByUserAsync(user.UserID);
            foreach (int tid in selTraits)
                await utdb.InsertAsync(user.UserID, tid);

            await ses.SetAsync("prefs", p);
            await ses.SetAsync("prefsTraits", selTraits);

            msg = "Saved!";
        }
        catch (Exception ex)
        {
            msg = "Save failed: " + ex.Message;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    void StartEdit() => isEditing = true;
    void CancelEdit() => isEditing = false;

    async Task UpdateUser()
    {
        if (working) return;

        try
        {
            working = true;

            CustomerDB db = new CustomerDB();
            await db.UpdateAsync(user);

            await ses.SetAsync("customer", user);

            isEditing = false;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task Logout()
    {
        await ses.DeleteAsync("customer");
        await ses.DeleteAsync("prefs");
        await ses.DeleteAsync("prefsTraits");
        nav.NavigateTo("/login", true);
    }

    void GoAdmin()
    {
        nav.NavigateTo("/admin", true);
    }
}

<style>
    .account-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: calc(100vh - 60px);
        background: #f8faf9;
        padding: 30px 0;
        box-sizing: border-box;
    }

    .card {
        width: 560px;
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        box-sizing: border-box;
    }

    .logo {
        text-align: center;
        color: #2e5f3e;
        margin: 0 0 10px 0;
    }

    .title {
        text-align: center;
        margin: 0 0 18px 0;
        font-weight: 800;
    }

    .sec {
        margin-top: 14px;
        padding: 16px;
        border: 1px solid #eee;
        border-radius: 16px;
        background: #fbfbfb;
        box-sizing: border-box;
    }

    .secTitle {
        font-weight: 900;
        color: #2e5f3e;
        margin-bottom: 10px;
    }

    .input {
        width: 100%;
        padding: 12px;
        margin: 8px 0;
        border: 1px solid #ccc;
        border-radius: 10px;
        box-sizing: border-box;
        font: inherit;
        background: white;
    }

    .btn {
        width: 100%;
        background-color: #2e5f3e;
        color: white;
        padding: 10px;
        border: 1px solid transparent;
        border-radius: 10px;
        cursor: pointer;
        margin-top: 10px;
        box-sizing: border-box;
        font: inherit;
        font-weight: 800;
    }

        .btn.gray {
            background: #777;
        }

        .btn.blue {
            background: #2e7d9f;
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .msg {
        margin-top: 10px;
        font-weight: 800;
        min-height: 18px;
    }

    .lnk {
        display: inline-block;
        margin-right: 8px;
        margin-top: 8px;
        padding: 10px 14px;
        border-radius: 12px;
        background: #eef5f0;
        border: 1px solid #dcece1;
        color: #2e5f3e;
        text-decoration: none;
        font-weight: 900;
    }

    .traitsBox {
        margin-top: 10px;
        padding: 14px;
        border: 1px solid #e9e9e9;
        border-radius: 14px;
        background: #fff;
    }

    .traitsTitle {
        font-weight: 900;
        margin-bottom: 10px;
        color: #2e5f3e;
    }

    .traitsGrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .trItem {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px 10px;
        border-radius: 12px;
        background: #fbfbfb;
        border: 1px solid #eee;
        font-weight: 800;
    }

    @@media (max-width: 650px) {
        .card {
            width: 92%;
        }

        .traitsGrid {
            grid-template-columns: 1fr;
        }
    }
</style>