@page "/login"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IServiceProvider ServiceProvider

<div class="login-container">
    <div class="card">
        <h2 class="logo">🐾 PawMatch</h2>
        <h3 class="title">Login</h3>

        <input type="text" class="input" placeholder="Email" @bind="email" />
        <input type="password" class="input" placeholder="Password" @bind="pass" />

        <button class="btn" @onclick="CheckLogin">Login</button>

        <p class="switch-text">
            Don't have an account? <a class="switch-link" href="/register">Register</a>
        </p>

        <p class="msg">@message</p>
    </div>
</div>

@code {
    CustomerDB db = new CustomerDB();

    ProtectedSessionStorage ses;
    NavigationManager nav;

    string email = "";
    string pass = "";
    string message = "";

    protected override void OnInitialized()
    {
        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));
    }

    async Task CheckLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(pass))
        {
            message = "Please enter both email and password.";
            return;
        }

        Customer found = await db.SelectByEmailAndPasswordAsync(email, pass);

        if (found != null)
        {
            await ses.SetAsync("customer", found);
            nav.NavigateTo("/myaccount", true);
        }
        else
        {
            message = "Email or password incorrect.";
        }
    }
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: calc(100vh - 60px);
        background: #f8faf9;
        padding-top: 60px;
        padding-bottom: 40px;
    }

    .card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        width: 320px;
        text-align: center;
    }

    .logo {
        color: #2e5f3e;
        margin-bottom: 16px;
    }

    .title {
        margin: 0 0 18px 0;
        font-weight: 800;
    }

    .input {
        width: 100%;
        padding: 10px;
        margin: 8px 0;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
        font: inherit;
    }

    .btn {
        width: 100%;
        background-color: #2e5f3e;
        color: white;
        padding: 10px;
        border: 1px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        box-sizing: border-box;
        font: inherit;
    }

    .switch-text {
        margin-top: 15px;
    }

    .switch-link {
        color: #2e5f3e;
        text-decoration: none;
        font-weight: bold;
    }

    .msg {
        margin-top: 12px;
        color: #c0392b;
        min-height: 20px;
        font-weight: 700;
    }
</style>
