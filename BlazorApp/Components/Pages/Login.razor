@page "/login"
@using DBL
@using Models
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IServiceProvider ServiceProvider

<div class="login-container">
    <div class="card">
        <h2 class="logo">🐾 PawMatch</h2>

        @if (!forgotMode)
        {
            <h3 class="title">Login</h3>

            <input type="text" class="input" placeholder="Email" @bind="email" />
            <input type="password" class="input" placeholder="Password" @bind="pass" />

            <button class="btn" @onclick="CheckLogin">Login</button>

            <p class="switch-text">
                Don't have an account? <a class="switch-link" href="/register">Register</a>
            </p>

            <p class="switch-text">
                <a class="switch-link" href="javascript:void(0)" @onclick="OpenForgot">Forgot password?</a>
            </p>

            <p class="msg">@message</p>
        }
        else
        {
            <h3 class="title">Forgot Password</h3>

            @if (step == 1)
            {
                <input type="text" class="input" placeholder="Email" @bind="fpEmail" />
                <button class="btn" @onclick="SendCode">Send Code</button>

                <p class="switch-text">
                    <a class="switch-link" href="javascript:void(0)" @onclick="BackToLogin">Back to login</a>
                </p>

                <p class="msg">@message</p>
            }
            else
            {
                <input type="text" class="input" placeholder="Code from email" @bind="codeInput" />
                <input type="password" class="input" placeholder="New password" @bind="newPass" />
                <input type="password" class="input" placeholder="Repeat new password" @bind="newPass2" />

                <button class="btn" @onclick="ResetPassword">Change Password</button>

                <p class="switch-text">
                    <a class="switch-link" href="javascript:void(0)" @onclick="BackToLogin">Back to login</a>
                </p>

                <p class="msg">@message</p>
            }
        }
    </div>
</div>

@code {
    CustomerDB db = new CustomerDB();

    ProtectedSessionStorage ses;
    NavigationManager nav;
    EmailService mail;

    string email = "";
    string pass = "";
    string message = "";

    bool forgotMode = false;

    int step = 1;
    string fpEmail = "";
    string codeSent = "";
    string codeInput = "";
    string newPass = "";
    string newPass2 = "";

    protected override void OnInitialized()
    {
        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));
        mail = (EmailService)ServiceProvider.GetService(typeof(EmailService));
    }

    async Task CheckLogin()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(pass))
        {
            message = "Please enter both email and password.";
            return;
        }

        // הצפנת הסיסמה שהוזנה לפני החיפוש ב-DB
        string hashedPass = Helper.HashPassword(pass);
        Customer found = await db.SelectByEmailAndPasswordAsync(email, hashedPass);

        if (found != null)
        {
            await ses.SetAsync("customer", found);
            nav.NavigateTo("/myaccount", true);
        }
        else
        {
            message = "Email or password incorrect.";
        }
    }

    void OpenForgot()
    {
        message = "";
        forgotMode = true;
        step = 1;
        fpEmail = "";
        codeSent = "";
        codeInput = "";
        newPass = "";
        newPass2 = "";
    }

    void BackToLogin()
    {
        message = "";
        forgotMode = false;
    }

    async Task SendCode()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(fpEmail))
        {
            message = "Please enter your email.";
            return;
        }

        Customer u = await db.SelectByEmailAsync(fpEmail);
        if (u == null)
        {
            message = "Email not found.";
            return;
        }

        codeSent = new Random().Next(100000, 999999).ToString();

        try
        {
            await mail.SendAsync(fpEmail, "PawMatch - Password Reset Code", "Your code is: " + codeSent);
            step = 2;
            message = "Code sent. Check your email.";
        }
        catch (Exception ex)
        {
            message = "Send failed: " + ex.Message;
        }
    }

    async Task ResetPassword()
    {
        message = "";

        if (string.IsNullOrWhiteSpace(codeInput) || string.IsNullOrWhiteSpace(newPass) || string.IsNullOrWhiteSpace(newPass2))
        {
            message = "Please fill all fields.";
            return;
        }

        if (codeInput.Trim() != codeSent)
        {
            message = "Wrong code.";
            return;
        }

        if (newPass != newPass2)
        {
            message = "Passwords do not match.";
            return;
        }

        // הצפנת הסיסמה החדשה לפני השמירה
        string hashedNewPass = Helper.HashPassword(newPass);

        int rows = await db.UpdatePasswordByEmailAsync(fpEmail, hashedNewPass);
        if (rows > 0)
        {
            message = "Password updated. You can login now.";
            forgotMode = false;
            email = fpEmail;
            pass = "";
        }
        else
        {
            message = "Update failed.";
        }
    }
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: calc(100vh - 60px);
        background: #f8faf9;
        padding-top: 60px;
        padding-bottom: 40px;
    }

    .card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        width: 340px;
        text-align: center;
        box-sizing: border-box;
    }

    .logo {
        color: #2e5f3e;
        margin-bottom: 16px;
    }

    .title {
        margin: 0 0 18px 0;
        font-weight: 800;
    }

    .input {
        width: 100%;
        padding: 10px;
        margin: 8px 0;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
        font: inherit;
    }

    .btn {
        width: 100%;
        background-color: #2e5f3e;
        color: white;
        padding: 10px;
        border: 1px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        box-sizing: border-box;
        font: inherit;
        font-weight: 800;
    }

    .switch-text {
        margin-top: 15px;
    }

    .switch-link {
        color: #2e5f3e;
        text-decoration: none;
        font-weight: bold;
    }

    .msg {
        margin-top: 12px;
        color: #c0392b;
        min-height: 20px;
        font-weight: 700;
    }
</style>