@page "/login"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ProtectedSessionStorage MySession
@inject NavigationManager Nav

<div class="login-container">
    <div class="login-card">
        <h2 class="logo">🐾 PawMatch</h2>
        <h3 class="title">Login</h3>

        <input type="text" class="inp" @bind="loginData.Email" placeholder="Email" />
        <input type="password" class="inp" @bind="loginData.Password" placeholder="Password" />

        <button class="login-btn" @onclick="CheckLogin">Login</button>

        <p class="switch-text">
            Don't have an account? <a class="switch-link" href="/register">Register</a>
        </p>

        <p class="msg">@message</p>
    </div>
</div>

@code {
    CustomerDB db = new CustomerDB();
    LoginData loginData = new LoginData();
    string message = "";

    async Task CheckLogin()
    {
        Customer found = await db.SelectByEmailAndPasswordAsync(loginData.Email, loginData.Password);

        if (found != null)
        {
            await MySession.SetAsync("customer", found);
            Nav.NavigateTo("/myaccount");
        }
        else
        {
            message = "❌ Email or password incorrect.";
        }
    }

    class LoginData
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        background: #f8faf9;
        padding-top: 120px;
        padding-bottom: 40px;
    }


    .login-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        width: 340px;
        text-align: center;
    }

    .logo {
        color: #2e5f3e;
        margin: 0 0 14px 0;
    }

    .title {
        margin: 0 0 18px 0;
        font-weight: 800;
    }

    .inp {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        margin: 8px 0;
        border: 1px solid #ccc;
        border-radius: 10px;
        font: inherit;
    }

    .login-btn {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        border-radius: 10px;
        background: #2e5f3e;
        color: white;
        border: 1px solid transparent;
        cursor: pointer;
        margin-top: 10px;
        font: inherit;
    }

    .switch-text {
        margin-top: 16px;
    }

    .switch-link {
        color: #2e5f3e;
        text-decoration: none;
        font-weight: 800;
    }

    .msg {
        margin-top: 12px;
        color: #c0392b;
        min-height: 20px;
    }
</style>
