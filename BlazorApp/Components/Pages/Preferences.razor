@page "/preferences"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject IServiceProvider ServiceProvider

<h2 class="title">Preferences</h2>

@if (!loaded)
{
    <p>Loading...</p>
}
else
{
    <div class="box">
        <select class="input" @bind="typeID" @bind:after="TypeChanged">
            <option value="0">Select Type</option>
            @foreach (var t in types)
            {
                <option value="@t.TypeID">@t.Description</option>
            }
        </select>

        <select class="input" @bind="raceID" disabled="@IsRaceDisabled()">
            <option value="0">Select Race</option>
            @foreach (var r in races)
            {
                <option value="@r.PetRaceID">@r.Description</option>
            }
        </select>

        <button class="btn" @onclick="Save">Save</button>
        <p class="msg">@msg</p>
    </div>
}

@code {
    ProtectedSessionStorage ses;
    NavigationManager nav;

    Customer cu;
    bool loaded = false;

    List<PetType> types = new();
    List<PetRace> races = new();

    int typeID = 0;
    int raceID = 0;

    string msg = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));

        var res = await ses.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login", true);
            return;
        }

        cu = res.Value;

        PetTypeDB tdb = new PetTypeDB();
        types = await tdb.GetAllAsync();

        UserPrefsDB pdb = new UserPrefsDB();
        var pr = await pdb.GetPrefsAsync(cu.UserID);

        if (pr != null)
        {
            typeID = pr.PrefTypeID;
            raceID = pr.PrefRaceID;

            if (typeID != 0)
            {
                PetRaceDB rdb = new PetRaceDB();
                races = await rdb.GetByTypeAsync(typeID);
            }
        }

        loaded = true;
        StateHasChanged();
    }

    bool IsRaceDisabled()
    {
        return typeID == 0 || races == null || races.Count == 0;
    }

    async Task TypeChanged()
    {
        raceID = 0;
        msg = "";
        races = new();

        if (typeID == 0) return;

        PetRaceDB rdb = new PetRaceDB();
        races = await rdb.GetByTypeAsync(typeID);
    }

    async Task Save()
    {
        UserPrefs p = new UserPrefs
        {
            UserID = cu.UserID,
            CanAdopt = 0,
            CanUpload = 0,
            PrefTypeID = typeID,
            PrefRaceID = raceID
        };

        UserPrefsDB pdb = new UserPrefsDB();
        await pdb.SavePrefsAsync(p);

        msg = "Saved!";
    }
}

<style>
    .title {
        text-align: center;
        margin-bottom: 20px;
        color: #2e5f3e;
    }

    .box {
        width: 420px;
        margin: auto;
        padding: 30px;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .input {
        width: 100%;
        padding: 12px;
        margin: 10px 0;
        border-radius: 8px;
        border: 1px solid #ccc;
        box-sizing: border-box;
    }

    .btn {
        width: 100%;
        padding: 12px;
        background: #2e5f3e;
        color: white;
        border: 1px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        font-weight: 800;
        box-sizing: border-box;
    }

    .msg {
        margin-top: 10px;
        font-weight: 800;
    }
</style>
