@page "/addpet"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.AspNetCore.Components.Forms
@inject IServiceProvider ServiceProvider

<h2 class="title">Add New Pet</h2>

@if (!loaded)
{
    <p>Loading...</p>
}
else
{
    <div class="form-container">

        <input class="input" placeholder="Pet Name" @bind="petName" disabled="@working" />
        <input class="input" placeholder="Pet Address" @bind="petAddress" disabled="@working" />

        <select class="input" value="@selectedTypeID" @onchange="OnTypeChange" disabled="@working">
            <option value="0">Select Type</option>
            @foreach (var t in types)
            {
                <option value="@t.TypeID">@t.Description</option>
            }
        </select>

        <select class="input" @bind="selectedRaceID" disabled="@(selectedTypeID == 0 || working)">
            <option value="0">Select Race</option>
            @foreach (var r in races)
            {
                <option value="@r.PetRaceID">@r.Description</option>
            }
        </select>

        <input class="input" placeholder="Birth Year" @bind="birthYearText" disabled="@working" />

        <div class="traitsBox">
            <div class="traitsTitle">Pet Traits</div>

            <div class="traitsGrid">
                @foreach (var tr in traits)
                {
                    <label class="trItem">
                        <input type="checkbox"
                               checked="@selTraits.Contains(tr.TraitID)"
                               disabled="@working"
                               @onchange="(e) => ToggleTrait(tr.TraitID, e)" />
                        <span>@tr.TraitName</span>
                    </label>
                }
            </div>
        </div>

        <div class="picBox">
            <div class="picTitle">Picture</div>

            @if (!string.IsNullOrEmpty(fileName))
            {
                <img class="prev" src="@GetPreviewImg()" />
            }

            <InputFile class="input" OnChange="HandleFile" disabled="@working" />
        </div>

        <button class="btn" @onclick="AddPetToDB" disabled="@working">Add Pet</button>

        <p class="msg">@message</p>
    </div>
}

@code {
    ProtectedSessionStorage ses;
    NavigationManager nav;

    Customer cu;
    bool loaded = false;
    bool working = false;

    string petName = "";
    string petAddress = "";
    int selectedTypeID = 0;
    int selectedRaceID = 0;

    string birthYearText = "";
    string fileName = "";
    string message = "";
    List<PetType> types = new();
    List<PetRace> races = new();

    List<Trait> traits = new();
    List<int> selTraits = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        nav = (NavigationManager)ServiceProvider.GetService(typeof(NavigationManager));
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));

        var res = await ses.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login", true);
            return;
        }

        cu = res.Value;

        PetTypeDB tdb = new PetTypeDB();
        types = await tdb.GetAllAsync();

        PetTraitsDB trdb = new PetTraitsDB();
        traits = await trdb.GetAllAsync();

        loaded = true;
        StateHasChanged();
    }

    async Task OnTypeChange(ChangeEventArgs e)
    {
        if (working) return;

        selectedRaceID = 0;
        races = new();

        int v = 0;
        if (e != null && e.Value != null)
            int.TryParse(e.Value.ToString(), out v);

        selectedTypeID = v;

        await InvokeAsync(StateHasChanged);

        if (selectedTypeID == 0) return;

        PetRaceDB rdb = new PetRaceDB();
        races = await rdb.GetByTypeAsync(selectedTypeID);

        await InvokeAsync(StateHasChanged);
    }

    void ToggleTrait(int id, ChangeEventArgs e)
    {
        bool v = false;
        if (e != null && e.Value != null)
        {
            if (e.Value is bool)
                v = (bool)e.Value;
            else
            {
                string s = e.Value.ToString();
                if (s == "true" || s == "True" || s == "on" || s == "On")
                    v = true;
            }
        }

        if (v)
        {
            if (!selTraits.Contains(id))
                selTraits.Add(id);
        }
        else
        {
            selTraits.Remove(id);
        }
    }

    async Task HandleFile(InputFileChangeEventArgs e)
    {
        if (working) return;

        try
        {
            working = true;
            message = "Uploading...";
            await InvokeAsync(StateHasChanged);

            var file = e.File;
            if (file == null)
            {
                fileName = "";
                message = "";
                return;
            }

            string ext = Path.GetExtension(file.Name);
            string newName = Guid.NewGuid().ToString() + ext;

            string folder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "PetPics");
            Directory.CreateDirectory(folder);

            string path = Path.Combine(folder, newName);
            long maxSize = 5 * 1024 * 1024;
            using var fs = new FileStream(path, FileMode.Create);
            await file.OpenReadStream(maxSize).CopyToAsync(fs);

            fileName = newName;
            message = "Picture selected.";
        }
        catch (Exception ex)
        {
            fileName = "";
            message = "Upload failed: " + ex.Message;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    string GetPreviewImg()
    {
        if (string.IsNullOrEmpty(fileName))
            return "/PetPics/noimg.png";

        return "/PetPics/" + fileName.Trim();
    }

    async Task AddPetToDB()
    {
        if (working) return;

        try
        {
            working = true;
            message = "Saving...";
            await InvokeAsync(StateHasChanged);

            if (string.IsNullOrWhiteSpace(petName) || string.IsNullOrWhiteSpace(petAddress))
            {
                message = "Please fill all fields.";
                return;
            }

            if (selectedTypeID == 0 || selectedRaceID == 0)
            {
                message = "Please select type and race.";
                return;
            }

            if (!int.TryParse(birthYearText, out int birthYear))
            {
                message = "Birth Year must be a number.";
                return;
            }

            if (string.IsNullOrWhiteSpace(fileName))
            {
                message = "Please upload a picture.";
                return;
            }

            PetsDB db = new PetsDB();
            Pet p = new Pet
            {
                PetName = petName,
                PetAdress = petAddress,
                PetType = selectedTypeID,
                PetRaceID = selectedRaceID,
                PetBirthYear = birthYear,
                PetPicture = fileName.Trim(),
                UpdateUserID = cu.UserID,
                IsActive = 1
            };

            var ins = await db.InsertGetObjAsync(p);
            if (ins == null)
            {
                message = "Insert failed.";
                return;
            }

            PetsTraitsDB ptDb = new PetsTraitsDB();
            await ptDb.DeleteByPetAsync(ins.PetID);

            foreach (int tid in selTraits)
                await ptDb.InsertAsync(ins.PetID, tid);

            message = "Saved.";

            // Navigate away to prevent double clicking/submission
            nav.NavigateTo("/mypets");
        }
        catch (Exception ex)
        {
            message = "Save failed: " + ex.Message;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}

<style>
    .title {
        text-align: center;
        margin-bottom: 20px;
        color: #2e5f3e;
    }

    .form-container {
        width: 560px;
        margin: auto;
        padding: 30px;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .input {
        width: 100%;
        padding: 12px;
        margin: 10px 0;
        border-radius: 8px;
        border: 1px solid #ccc;
        box-sizing: border-box;
    }

    .btn {
        width: 100%;
        padding: 12px;
        background: #2e5f3e;
        color: white;
        border: 1px solid transparent;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        font-weight: 800;
        box-sizing: border-box;
    }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .traitsBox {
        margin-top: 8px;
        padding: 14px;
        border: 1px solid #e9e9e9;
        border-radius: 14px;
        background: #fbfbfb;
    }

    .traitsTitle {
        font-weight: 900;
        margin-bottom: 10px;
        color: #2e5f3e;
    }

    .traitsGrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .trItem {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 8px 10px;
        border-radius: 12px;
        background: white;
        border: 1px solid #eee;
        font-weight: 700;
    }

    .picBox {
        margin-top: 12px;
        padding: 14px;
        border: 1px solid #e9e9e9;
        border-radius: 14px;
        background: #fbfbfb;
    }

    .picTitle {
        font-weight: 900;
        margin-bottom: 10px;
        color: #2e5f3e;
    }

    .prev {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid #eee;
        background: white;
        margin-bottom: 10px;
        display: block;
    }

    .msg {
        margin-top: 10px;
        font-weight: 800;
        min-height: 20px;
    }

    @@media (max-width: 650px) {
        .form-container {
            width: 92%;
        }

        .traitsGrid {
            grid-template-columns: 1fr;
        }
    }
</style>