@page "/mypets"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager Nav

<div>
    <header>
        <h1>My Pets</h1>
        <button type="button" @onclick="LoadData">Refresh</button>
    </header>

    @if (errorMessage != "")
    {
        <span>@errorMessage</span>
    }

    <main>
        @if (userPets != null)
        {
            @foreach (var pet in userPets)
            {
                <section>
                    <div>
                        <img src="@($"PetPics/{pet.PetPicture}")" alt="Pet Image" />
                    </div>

                    <article>
                        <header>
                            <h3>@pet.PetName</h3>
                            <em>@(pet.IsActive == 1 ? "Visible" : "Hidden")</em>
                        </header>
                        <p>City: @pet.PetAdress</p>
                        <p>Birth Year: @pet.PetBirthYear</p>
                    </article>

                    <footer>
                        <button type="button" @onclick="() => ToggleVisibility(pet)">
                            @(pet.IsActive == 1 ? "Hide" : "Show")
                        </button>
                        <button type="button" @onclick="() => GoToEdit(pet.PetID)">
                            Edit
                        </button>
                    </footer>
                </section>
            }
        }
    </main>
</div>

@code {
    // Manual initialization of objects
    private List<Pet> userPets = new List<Pet>();
    private Customer currentUser = new Customer();
    private string errorMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load data only on first render to safely access SessionStorage
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        errorMessage = "";
        try
        {
            // Retrieve the logged-in user from session
            var sessionResult = await MySession.GetAsync<Customer>("customer");

            if (sessionResult.Success && sessionResult.Value != null)
            {
                currentUser = sessionResult.Value;

                // Direct call to your database layer
                PetsDB db = new PetsDB();
                userPets = await db.GetByUserAsync(currentUser.UserID);
            }
            else
            {
                // Redirect if user is not logged in
                Nav.NavigateTo("/login");
            }
        }
        catch (Exception)
        {
            // Manual error handling
            errorMessage = "System Error: Could not retrieve your pet listings.";
        }
    }

    private async Task ToggleVisibility(Pet pet)
    {
        try
        {
            // Toggle the integer value (1 for Active, 0 for Inactive)
            int newStatus = pet.IsActive == 1 ? 0 : 1;

            PetsDB db = new PetsDB();
            await db.SetActiveAsync(pet.PetID, newStatus);

            // Update the local object only after DB success
            pet.IsActive = newStatus;
        }
        catch (Exception)
        {
            errorMessage = "Error: Failed to update visibility status.";
        }
    }

    private void GoToEdit(int petId)
    {
        // Navigation logic for editing the pet
        Nav.NavigateTo($"/addpet/{petId}");
    }
}

<style>
    /* Styling based entirely on HTML tags to enforce the strict separation rule */

    div > header {
        max-width: 1000px;
        margin: 0 auto 30px auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Segoe UI', sans-serif;
    }

        div > header > h1 {
            color: #2e5f3e;
            margin: 0;
        }

        div > header > button {
            padding: 10px 20px;
            background-color: #2e5f3e;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }

    div > span {
        display: block;
        color: #d9534f;
        text-align: center;
        font-weight: bold;
        margin-bottom: 20px;
        font-family: sans-serif;
    }

    main {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
        justify-content: center;
        max-width: 1100px;
        margin: auto;
        font-family: 'Segoe UI', sans-serif;
    }

    section {
        width: 320px;
        border: 1px solid #e9e9e9;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        padding: 15px;
        box-sizing: border-box;
    }

        section > div {
            height: 200px;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 15px;
        }

            section > div > img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

    article {
        flex-grow: 1;
    }

        article > header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            border: none; /* Resetting the outer header style */
            padding: 0;
        }

            article > header > h3 {
                margin: 0;
                color: #333;
                font-size: 1.4rem;
            }

            article > header > em {
                background-color: #eef5f0;
                color: #2e5f3e;
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 0.85rem;
                font-weight: bold;
                font-style: normal;
                border: 1px solid #dcece1;
            }

        article > p {
            margin: 5px 0;
            color: #666;
            font-size: 0.95rem;
        }

    footer {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        border-top: 1px solid #eee;
        padding-top: 15px;
    }

        footer > button {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            color: white;
            transition: opacity 0.2s;
        }

            footer > button:hover {
                opacity: 0.8;
            }

            /* Style for the 'Hide/Show' button */
            footer > button:first-child {
                background-color: #777;
            }

            /* Style for the 'Edit' button */
            footer > button:last-child {
                background-color: #2e5f3e;
            }
</style>