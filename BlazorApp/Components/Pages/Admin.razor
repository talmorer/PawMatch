@page "/admin"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using MySql.Data.MySqlClient
@inject ProtectedSessionStorage MySession
@inject NavigationManager nav
@inject IJSRuntime js

<div class="admin-container">
    <div class="card admin-card-wide">
        <h2 class="logo">🐾 PawMatch</h2>
        <h3>Admin Dashboard</h3>

        <button class="btn back" @onclick="@(() => nav.NavigateTo("/myaccount"))">⬅ Back to My Account</button>

        @if (admin == null)
        {
            <p>Loading...</p>
        }
        else if (admin.IsAdmin == false)
        {
            <p>Access denied. You are not an admin.</p>
        }
        else
        {
            <p>Welcome back, @admin.FirstName 👋</p>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="@messageClass">@message</div>
            }

            <div class="admin-section">
                <h4>👥 Users Management</h4>
                @if (users == null)
                {
                    <p>Loading users...</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Admin</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in users)
                                {
                                    <tr>
                                        <td>@u.UserID</td>
                                        <td>@u.FirstName @u.LastName</td>
                                        <td>@u.Email</td>
                                        <td>@u.Phone</td>
                                        <td>@(u.IsAdmin ? "Yes" : "No")</td>
                                        <td>
                                            @if (u.IsAdmin == false)
                                            {
                                                <button class="btn delete" @onclick="() => DeleteUser(u)">Delete</button>
                                            }
                                            else
                                            {
                                                <span style="color:gray;">(Admin)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="admin-section">
                <h4>🐾 Pets Management</h4>
                @if (adminPets == null || adminPets.Count == 0)
                {
                    <p>Loading pets...</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Pet Name</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in adminPets)
                                {
                                    <tr>
                                        <td>@p.PetID</td>
                                        <td>@p.PetName</td>
                                        <td>
                                            <span style="font-weight:bold; color:@(p.IsActive == 1 ? "green" : "red")">
                                                @(p.IsActive == 1 ? "Active" : "Hidden")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn toggle-btn" @onclick="() => TogglePetStatus(p)">Toggle Status</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="admin-section">
                <h4>🚚 All Deliveries Overview</h4>
                @if (adminDeliveries == null || adminDeliveries.Count == 0)
                {
                    <p>No deliveries found or loading...</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>DLY-ID</th>
                                    <th>Receiver</th>
                                    <th>Pet Info</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in adminDeliveries)
                                {
                                    <tr>
                                        <td>DLY-@d.DeliveryID</td>
                                        <td>@d.ReceiverName<br /><small>@d.ReceiverEmail</small></td>
                                        <td>@d.PetDescription</td>
                                        <td><span class="badge-status">@d.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="admin-section flex-forms">
                <div class="form-box">
                    <h4>➕ Add Pet Type</h4>
                    <input class="admin-input" @bind="newTypeDesc" placeholder="e.g. Rabbit, Fish..." />
                    <button class="btn add-btn" @onclick="AddPetType">Add Type</button>
                </div>

                <div class="form-box">
                    <h4>➕ Add Pet Race</h4>
                    <select class="admin-input" @bind="newRaceTypeIdStr">
                        <option value="0">Select Pet Type...</option>
                        @foreach (var t in availableTypes)
                        {
                            <option value="@t.TypeID.ToString()">@t.Description</option>
                        }
                    </select>
                    <input class="admin-input" @bind="newRaceDesc" placeholder="e.g. Bulldog..." disabled="@(newRaceTypeIdStr == "0")" />
                    <button class="btn add-btn" @onclick="AddPetRace" disabled="@(newRaceTypeIdStr == "0")">Add Race</button>
                </div>

                <div class="form-box">
                    <h4>➕ Add Trait</h4>
                    <input class="admin-input" @bind="newTraitName" placeholder="e.g. Fluffy, Energetic..." />
                    <button class="btn add-btn" @onclick="AddTrait">Add Trait</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    Customer admin;
    List<Customer> users = new();

    List<AdminPet> adminPets = new();
    List<AdminDelivery> adminDeliveries = new();
    List<PetType> availableTypes = new();

    string newTypeDesc = "";
    string newRaceTypeIdStr = "0";
    string newRaceDesc = "";
    string newTraitName = "";

    string message = "";
    string messageClass = "";

    string projectConn = "server=localhost;database=project;uid=root;pwd=josh17rog;";
    string apiConn = "server=localhost;database=petdex;uid=root;pwd=josh17rog;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var session = await MySession.GetAsync<Customer>("customer");
            if (session.Success && session.Value != null)
            {
                admin = session.Value;
                if (admin.IsAdmin)
                {
                    CustomerDB db = new CustomerDB();
                    users = await db.GetAllAsync();

                    await LoadPets();
                    await LoadDeliveries();
                    await LoadPetTypes();

                    StateHasChanged();
                }
                else
                {
                    nav.NavigateTo("/myaccount");
                }
            }
            else
            {
                nav.NavigateTo("/login");
            }
        }
    }

    async Task LoadPetTypes()
    {
        availableTypes.Clear();
        try
        {
            using (MySqlConnection conn = new MySqlConnection(projectConn))
            {
                await conn.OpenAsync();
                string sql = "SELECT TypeID, Description FROM pet_type";
                using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                using (var reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        availableTypes.Add(new PetType
                        {
                            TypeID = reader.GetInt32(reader.GetOrdinal("TypeID")),
                            Description = reader.GetString(reader.GetOrdinal("Description"))
                        });
                    }
                }
            }
        }
        catch { }
    }

    async Task DeleteUser(Customer user)
    {
        message = "";
        bool confirm = await js.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {user.FirstName} {user.LastName}?");
        if (!confirm) return;

        try
        {
            CustomerDB db = new CustomerDB();
            int result = await db.DeleteAsync(user);

            if (result > 0)
            {
                users.Remove(user);
                message = $"{user.FirstName} {user.LastName} was deleted.";
                messageClass = "success-box";
            }
            else
            {
                message = "Delete failed.";
                messageClass = "error-box";
            }
        }
        catch (Exception ex)
        {
            message = "Error: " + ex.Message;
            messageClass = "error-box";
        }
        StateHasChanged();
    }

    async Task LoadPets()
    {
        adminPets.Clear();
        try
        {
            using (MySqlConnection conn = new MySqlConnection(projectConn))
            {
                await conn.OpenAsync();
                string sql = "SELECT PetID, PetName, IsActive FROM pets ORDER BY PetID DESC";
                using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                using (var reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        adminPets.Add(new AdminPet
                        {
                            PetID = reader.GetInt32(reader.GetOrdinal("PetID")),
                            PetName = reader.IsDBNull(reader.GetOrdinal("PetName")) ? "Unknown" : reader.GetString(reader.GetOrdinal("PetName")),
                            IsActive = reader.GetInt32(reader.GetOrdinal("IsActive"))
                        });
                    }
                }
            }
        }
        catch { }
    }

    async Task LoadDeliveries()
    {
        adminDeliveries.Clear();
        try
        {
            using (MySqlConnection conn = new MySqlConnection(apiConn))
            {
                await conn.OpenAsync();
                string sql = "SELECT DeliveryID, ReceiverName, ReceiverEmail, PetDescription, Status FROM Deliveries ORDER BY DeliveryID DESC";
                using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                using (var reader = await cmd.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        adminDeliveries.Add(new AdminDelivery
                        {
                            DeliveryID = reader.GetInt32(reader.GetOrdinal("DeliveryID")),
                            ReceiverName = reader.IsDBNull(reader.GetOrdinal("ReceiverName")) ? "" : reader.GetString(reader.GetOrdinal("ReceiverName")),
                            ReceiverEmail = reader.IsDBNull(reader.GetOrdinal("ReceiverEmail")) ? "" : reader.GetString(reader.GetOrdinal("ReceiverEmail")),
                            PetDescription = reader.IsDBNull(reader.GetOrdinal("PetDescription")) ? "" : reader.GetString(reader.GetOrdinal("PetDescription")),
                            Status = reader.IsDBNull(reader.GetOrdinal("Status")) ? "Pending" : reader.GetString(reader.GetOrdinal("Status"))
                        });
                    }
                }
            }
        }
        catch { }
    }

    async Task TogglePetStatus(AdminPet p)
    {
        message = "";
        try
        {
            PetsDB db = new PetsDB();
            int newStatus = p.IsActive == 1 ? 0 : 1;
            await db.SetActiveAsync(p.PetID, newStatus);
            p.IsActive = newStatus;

            message = $"Pet #{p.PetID} status updated!";
            messageClass = "success-box";
        }
        catch (Exception ex)
        {
            message = "Error: " + ex.Message;
            messageClass = "error-box";
        }
        StateHasChanged();
    }

    async Task AddPetType()
    {
        message = "";
        if (string.IsNullOrWhiteSpace(newTypeDesc))
        {
            message = "Type name is required.";
            messageClass = "error-box";
            return;
        }
        try
        {
            using (MySqlConnection conn = new MySqlConnection(projectConn))
            {
                await conn.OpenAsync();
                string sql = "INSERT INTO pet_type (Description) VALUES (@desc)";
                using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("@desc", newTypeDesc);
                    await cmd.ExecuteNonQueryAsync();
                }
            }
            message = $"Type '{newTypeDesc}' added successfully!";
            messageClass = "success-box";
            newTypeDesc = "";
            await LoadPetTypes();
        }
        catch (Exception ex)
        {
            message = "Type Error: " + ex.Message;
            messageClass = "error-box";
        }
        StateHasChanged();
    }

    async Task AddPetRace()
    {
        message = "";
        if (newRaceTypeIdStr == "0" || string.IsNullOrWhiteSpace(newRaceDesc))
        {
            message = "Please select a type and enter a race name.";
            messageClass = "error-box";
            return;
        }
        try
        {
            int tid = int.Parse(newRaceTypeIdStr);
            using (MySqlConnection conn = new MySqlConnection(projectConn))
            {
                await conn.OpenAsync();
                string sql = "INSERT INTO pet_race (PetTypeID, Description) VALUES (@tid, @desc)";
                using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("@tid", tid);
                    cmd.Parameters.AddWithValue("@desc", newRaceDesc);
                    await cmd.ExecuteNonQueryAsync();
                }
            }
            message = $"Race '{newRaceDesc}' added successfully!";
            messageClass = "success-box";
            newRaceDesc = "";
            newRaceTypeIdStr = "0";
        }
        catch (Exception ex)
        {
            message = "Race Error: " + ex.Message;
            messageClass = "error-box";
        }
        StateHasChanged();
    }

    async Task AddTrait()
    {
        message = "";
        if (string.IsNullOrWhiteSpace(newTraitName))
        {
            message = "Trait name is required.";
            messageClass = "error-box";
            return;
        }
        try
        {
            using (MySqlConnection conn = new MySqlConnection(projectConn))
            {
                await conn.OpenAsync();
                string sql = "INSERT INTO pet_traits (TraitName) VALUES (@name)";
                using (MySqlCommand cmd = new MySqlCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("@name", newTraitName);
                    await cmd.ExecuteNonQueryAsync();
                }
            }
            message = $"Trait '{newTraitName}' added successfully!";
            messageClass = "success-box";
            newTraitName = "";
        }
        catch (Exception ex)
        {
            message = "Trait Error: " + ex.Message;
            messageClass = "error-box";
        }
        StateHasChanged();
    }
}

<style>
    .admin-container {
        display: flex;
        justify-content: center;
        background: #f8faf9;
        min-height: 100vh;
        padding: 40px 20px;
        font-family: sans-serif;
    }

    .card {
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 1100px;
    }

    .logo {
        text-align: center;
        color: #2e5f3e;
    }

    h3 {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    .btn.back {
        background-color: #777;
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 15px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .table th, .table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center;
        }

        .table th {
            background-color: #2e5f3e;
            color: white;
        }

    .btn.delete {
        background-color: #b32121;
        color: white;
        border: none;
        padding: 6px 10px;
        border-radius: 8px;
        cursor: pointer;
    }

    .success-box {
        background-color: #dfffe0;
        color: #2e5f3e;
        border: 1px solid #2e5f3e;
        border-radius: 8px;
        padding: 10px;
        margin: 15px 0;
        text-align: center;
        font-weight: bold;
    }

    .error-box {
        background-color: #ffe3e3;
        color: #a30000;
        border: 1px solid #a30000;
        border-radius: 8px;
        padding: 10px;
        margin: 15px 0;
        text-align: center;
        font-weight: bold;
        word-wrap: break-word;
    }

    .admin-section {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 2px dashed #eee;
    }

        .admin-section h4 {
            color: #2e5f3e;
            margin-bottom: 15px;
            font-size: 1.2rem;
        }

    .table-responsive {
        overflow-x: auto;
    }

    .toggle-btn {
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 6px 10px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
    }

    .badge-status {
        background: #eef5f0;
        color: #2e5f3e;
        padding: 4px 8px;
        border-radius: 12px;
        font-weight: bold;
        font-size: 0.85rem;
    }

    .flex-forms {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .form-box {
        flex: 1;
        min-width: 250px;
        background: #f9f9f9;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #eee;
        display: flex;
        flex-direction: column;
    }

    .admin-input {
        width: 100%;
        padding: 10px;
        margin-bottom: 10px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
    }

    .add-btn {
        width: 100%;
        background-color: #2e5f3e;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        margin-top: auto;
    }
</style>