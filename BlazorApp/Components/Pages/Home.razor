@page "/"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Linq
@inject IServiceProvider ServiceProvider
@inject NavigationManager nav

<div class="page">
    <div class="top">
        <h2 class="logo">🐾 PawMatch</h2>
        <h3 class="title">Available Pets</h3>

        @if (!string.IsNullOrEmpty(prefText))
        {
            <div class="traitsLine">@prefText</div>
        }

        <div class="filters">
            <select class="input" @bind="SelectedTypeID">
                <option value="0">All Types</option>
                @foreach (var t in types)
                {
                    <option value="@t.TypeID">@t.Description</option>
                }
            </select>

            <select class="input" @bind="selectedRaceID" disabled="@(SelectedTypeID == 0 || races.Count == 0)">
                <option value="0">All Races</option>
                @foreach (var r in races)
                {
                    <option value="@r.PetRaceID">@r.Description</option>
                }
            </select>

            <input class="input" placeholder="Search by name or city" @bind="txt" />

            <button class="btn" @onclick="Search">Search</button>
        </div>
    </div>

    <div class="grid">
        @foreach (var p in pets)
        {
            <div class="card">
                <img class="pic" src="@GetImg(p.PetPicture)" />

                <div class="info">
                    <div class="name">@p.PetName</div>
                    <div class="meta">@p.TypeName • @p.RaceName</div>
                    <div class="meta">Birth Year: @p.PetBirthYear</div>
                    <div class="meta">City: @p.PetAdress</div>

                    @if (petTraitsText.ContainsKey(p.PetID) && !string.IsNullOrEmpty(petTraitsText[p.PetID]))
                    {
                        <div class="traitsLine">@petTraitsText[p.PetID]</div>
                    }

                    <div class="contactBox">
                        <div class="contactTitle">Contact</div>
                        <div class="meta">@p.UploaderFirstName @p.UploaderLastName</div>

                        <a class="link" href="mailto:@p.UploaderEmail">Email: @p.UploaderEmail</a>
                        <a class="link" href="tel:@p.UploaderPhone">Phone: @p.UploaderPhone</a>
                    </div>

                    <div class="actionBox">
                        <button class="btn-details" @onclick="() => GoToDetails(p.PetID)">View Details & Adopt</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    ProtectedSessionStorage ses;

    List<Pet> pets = new();
    List<PetType> types = new();
    List<PetRace> races = new();

    List<Trait> allTraits = new();
    List<PetTrait> allPetTraits = new();
    Dictionary<int, string> petTraitsText = new();

    string prefText = "";
    List<int> userTraitsFilter = new List<int>();

    int _typeID = 0;
    int SelectedTypeID
    {
        get => _typeID;
        set
        {
            _typeID = value;
            _ = LoadRacesAndSearch(false);
        }
    }

    int selectedRaceID = 0;
    string txt = "";

    // משתנים לשמירת ההעדפות כדי למיין אותן למעלה
    int basePrefType = 0;
    int basePrefRace = 0;

    protected override async Task OnInitializedAsync()
    {
        ses = (ProtectedSessionStorage)ServiceProvider.GetService(typeof(ProtectedSessionStorage));

        PetTypeDB tdb = new PetTypeDB();
        types = await tdb.GetAllAsync();

        PetTraitsDB trdb = new PetTraitsDB();
        allTraits = await trdb.GetAllAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await ApplyPrefs();
        await LoadRacesAndSearch(true);

        await InvokeAsync(StateHasChanged);
    }

    async Task ApplyPrefs()
    {
        prefText = "";
        userTraitsFilter = new List<int>();

        var custRes = await ses.GetAsync<Customer>("customer");
        if (!custRes.Success || custRes.Value == null)
            return;

        int userId = custRes.Value.UserID;

        UserPrefs pref = null;
        var prefRes = await ses.GetAsync<UserPrefs>("prefs");
        if (prefRes.Success && prefRes.Value != null)
        {
            pref = prefRes.Value;
        }
        else
        {
            UserPrefsDB pdb = new UserPrefsDB();
            pref = await pdb.GetPrefsAsync(userId);
            if (pref != null)
                await ses.SetAsync("prefs", pref);
        }

        var traitRes = await ses.GetAsync<List<int>>("prefsTraits");
        if (traitRes.Success && traitRes.Value != null)
        {
            userTraitsFilter = traitRes.Value;
        }
        else
        {
            UserPrefsTraitsDB utdb = new UserPrefsTraitsDB();
            var lst = await utdb.GetByUserAsync(userId);
            foreach (var x in lst)
                userTraitsFilter.Add(x.TraitID);
            await ses.SetAsync("prefsTraits", userTraitsFilter);
        }

        // שומרים את ההעדפות בנפרד כדי למיין לפיהן את התצוגה
        if (pref != null)
        {
            basePrefType = pref.PrefTypeID;
            basePrefRace = pref.PrefRaceID;
        }

        if (pref == null && userTraitsFilter.Count == 0) return;

        List<string> chips = new();

        if (pref != null && pref.PrefTypeID != 0)
        {
            foreach (var t in types)
            {
                if (t.TypeID == pref.PrefTypeID)
                {
                    chips.Add(t.Description);
                    break;
                }
            }
        }
        else if (userTraitsFilter.Count > 0)
        {
            chips.Add("All Types");
        }

        if (pref != null && pref.PrefRaceID != 0)
            chips.Add("Race selected");

        if (userTraitsFilter.Count > 0)
        {
            List<string> tNames = new();
            foreach (int tid in userTraitsFilter)
            {
                var trObj = allTraits.FirstOrDefault(x => x.TraitID == tid);
                if (trObj != null) tNames.Add(trObj.TraitName);
            }
            if (tNames.Count > 0)
            {
                chips.Add("Traits: " + string.Join(", ", tNames));
            }
        }

        if (chips.Count > 0)
            prefText = "Preferences applied: " + string.Join(" • ", chips);
    }

    async Task LoadRacesAndSearch(bool keepRaceIfPossible)
    {
        if (_typeID == 0)
        {
            races = new();
            selectedRaceID = 0;
        }
        else
        {
            PetRaceDB rdb = new PetRaceDB();
            races = await rdb.GetByTypeAsync(_typeID);

            if (!keepRaceIfPossible)
                selectedRaceID = 0;
            else
            {
                if (selectedRaceID != 0)
                {
                    bool ok = false;
                    foreach (var r in races)
                    {
                        if (r.PetRaceID == selectedRaceID) { ok = true; break; }
                    }
                    if (!ok) selectedRaceID = 0;
                }
            }
        }

        await Search();
        await InvokeAsync(StateHasChanged);
    }

    async Task Search()
    {
        PetsDB db = new PetsDB();
        var rawPets = await db.SearchAsync(_typeID, selectedRaceID, txt);

        // סינון: חיות שנשלחו לא יופיעו בכלל
        rawPets = rawPets.Where(p => p.IsActive == 1).ToList();

        PetsTraitsDB ptrdb = new PetsTraitsDB();
        allPetTraits = await ptrdb.GetAllAsync();

        // מיון: עדיפות למועדפים שלך לפסגה
        if (userTraitsFilter != null && userTraitsFilter.Count > 0)
        {
            pets = rawPets.OrderByDescending(p =>
            {
                int matchCount = 0;
                foreach (var pt in allPetTraits)
                {
                    if (pt.PetID == p.PetID && userTraitsFilter.Contains(pt.TraitID))
                    {
                        matchCount++;
                    }
                }
                return matchCount;
            })
            .ThenByDescending(p => p.PetType == basePrefType && basePrefType != 0)
            .ThenByDescending(p => p.PetRaceID == basePrefRace && basePrefRace != 0)
            .ToList();
        }
        else
        {
            pets = rawPets
                .OrderByDescending(p => p.PetType == basePrefType && basePrefType != 0)
                .ThenByDescending(p => p.PetRaceID == basePrefRace && basePrefRace != 0)
                .ToList();
        }

        BuildTraitsText();
        await InvokeAsync(StateHasChanged);
    }

    void BuildTraitsText()
    {
        petTraitsText = new Dictionary<int, string>();
        Dictionary<int, string> traitNameById = new Dictionary<int, string>();
        foreach (var t in allTraits) traitNameById[t.TraitID] = t.TraitName;

        Dictionary<int, List<string>> namesByPet = new Dictionary<int, List<string>>();
        foreach (var pt in allPetTraits)
        {
            if (!traitNameById.ContainsKey(pt.TraitID)) continue;
            if (!namesByPet.ContainsKey(pt.PetID)) namesByPet[pt.PetID] = new List<string>();
            namesByPet[pt.PetID].Add(traitNameById[pt.TraitID]);
        }

        foreach (var kv in namesByPet)
        {
            if (kv.Value.Count == 0) continue;
            petTraitsText[kv.Key] = string.Join(" • ", kv.Value);
        }
    }

    string GetImg(string pic) => string.IsNullOrEmpty(pic) ? "/PetPics/noimg.png" : "/PetPics/" + pic;

    private async Task GoToDetails(int petId)
    {
        await ses.SetAsync("selectedPetId", petId);
        nav.NavigateTo("/petdetails");
    }
}

<style>
    * {
        box-sizing: border-box;
    }

    .page {
        min-height: 100vh;
        background: #f8faf9;
        padding: 30px;
    }

    .top {
        max-width: 1100px;
        margin: 0 auto 20px auto;
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

    .logo {
        color: #2e5f3e;
        margin: 0;
        text-align: center;
    }

    .title {
        margin: 10px 0 20px 0;
        text-align: center;
        font-weight: bold;
    }

    .filters {
        display: grid;
        grid-template-columns: 1fr 1fr 1.5fr 0.7fr;
        gap: 10px;
        align-items: stretch;
    }

    .input {
        width: 100%;
        height: 45px;
        padding: 0 12px;
        border-radius: 10px;
        border: 1px solid #ccc;
        background: white;
        margin: 0;
    }

    .btn {
        width: 100%;
        height: 45px;
        background: #2e5f3e;
        color: white;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 800;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .grid {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
    }

    .pic {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .info {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .name {
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .meta {
        font-size: 14px;
        margin: 3px 0;
        color: #333;
    }

    .traitsLine {
        margin-top: 8px;
        padding: 8px 10px;
        border-radius: 12px;
        background: #f3f6f4;
        border: 1px solid #e6eee9;
        color: #2e5f3e;
        font-weight: 800;
        font-size: 13px;
        text-align: center;
        margin-bottom: 15px;
    }

    .contactBox {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #eee;
        flex-grow: 1;
    }

    .contactTitle {
        font-weight: 800;
        margin-bottom: 6px;
    }

    .link {
        display: block;
        margin: 4px 0;
        color: #2e5f3e;
        text-decoration: none;
    }

    .actionBox {
        margin-top: 15px;
    }

    .btn-details {
        width: 100%;
        height: 40px;
        background: #2e5f3e;
        color: white;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        font-weight: bold;
        transition: background 0.2s;
    }

        .btn-details:hover {
            background: #244a30;
        }

    @@media (max-width: 1000px) {
        .grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .filters {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 650px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .filters {
            grid-template-columns: 1fr;
        }
    }
</style>