@page "/track"
@using System.Net.Http
@using System.Net.Http.Json
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject HttpClient Http
@inject NavigationManager nav

<div class="track-page-wrapper">
    @if (!loaded)
    {
        <div class="loading-state">Loading your deliveries...</div>
    }
    else
    {
        <main class="track-card">
            <header class="track-header">
                <h2 class="title">🚚 My Deliveries</h2>
                <p class="subtitle">Track the pets you've ordered</p>
                <p style="font-size: 0.85rem; color: #888;">Searching for user: @currentUser?.Email</p>
            </header>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="color: red; padding: 10px; border: 1px solid red; border-radius: 5px; margin-bottom: 20px;">
                    @errorMessage
                </div>
            }

            @if (myDeliveries == null || myDeliveries.Count == 0)
            {
                <div class="empty-state">
                    <p>You don't have any active deliveries.</p>
                    <button class="btn-primary" @onclick="GoHome">Find a Pet</button>
                </div>
            }
            else
            {
                <div class="deliveries-list">
                    @foreach (var del in myDeliveries)
                    {
                        <div class="delivery-item">
                            <div class="del-info">
                                <h4>@del.PetDescription</h4>
                                <p>Tracking ID: <b>DLY-@del.DeliveryID</b></p>
                            </div>
                            <div class="del-status">
                                <span class="status-badge @GetStatusClass(del.Status)">@del.Status</span>
                            </div>
                        </div>
                    }
                </div>

                <button class="btn-back-link" @onclick="GoHome" style="margin-top: 25px;">← Back to Search</button>
            }
        </main>
    }
</div>

@code {
    private bool loaded = false;
    private Customer currentUser = null;
    private List<MyDelivery> myDeliveries = new List<MyDelivery>();
    private string errorMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var userRes = await MySession.GetAsync<Customer>("customer");
        if (userRes.Success && userRes.Value != null)
        {
            currentUser = userRes.Value;
            await LoadMyDeliveries();
        }
        else
        {
            nav.NavigateTo("/login");
            return;
        }

        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMyDeliveries()
    {
        try
        {
            string apiUrl = $"https://localhost:7020/api/Deliveries/ByUser?email={currentUser.Email}";
            var result = await Http.GetFromJsonAsync<List<MyDelivery>>(apiUrl);
            if (result != null)
            {
                myDeliveries = result;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "API Error: Make sure the API is running (" + ex.Message + ")";
        }
    }

    private string GetStatusClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "status-pending";
        var s = status.ToLower();
        if (s.Contains("pending")) return "status-pending";
        if (s.Contains("transit")) return "status-transit";
        if (s.Contains("delivered")) return "status-delivered";
        return "status-pending";
    }

    private void GoHome() => nav.NavigateTo("/");

    public class MyDelivery
    {
        public int DeliveryID { get; set; }
        public string PetDescription { get; set; }
        public string Status { get; set; }
    }
}

<style>
