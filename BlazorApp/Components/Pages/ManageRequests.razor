@page "/managerequests"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage MySession
@inject NavigationManager nav

<div class="requests-container">
    @if (!loaded)
    {
        <div class="status-box">Loading adoption requests...</div>
    }
    else
    {
        <main class="content-card">
            <header>
                <h2 class="logo">🐾 PawMatch</h2>
                <h3>Manage Adoption Requests</h3>
                <p>Review people who want to adopt your pets</p>
            </header>

            @if (requestsList == null || requestsList.Count == 0)
            {
                <div class="empty-state">
                    <p>No pending adoption requests at the moment.</p>
                    <button class="btn btn-back" @onclick="GoBack">Back to My Account</button>
                </div>
            }
            else
            {
                <div class="requests-list">
                    @foreach (var req in requestsList)
                    {
                        <div class="request-item">
                            <div class="request-info">
                                <h4>Pet: @req.PetName</h4>
                                <p><b>Interested Adopter:</b> @req.AdopterFirstName</p>
                                <p><b>Phone:</b> @req.AdopterPhone</p>
                                <p><b>Status:</b> <span class="status-tag">@req.Status</span></p>
                            </div>

                            <div class="request-actions">
                                <button class="btn btn-approve" @onclick='() => ProcessRequest(req.RequestID, req.PetID, "Approved")' disabled="@working">Approve</button>
                                <button class="btn btn-reject" @onclick='() => ProcessRequest(req.RequestID, req.PetID, "Rejected")' disabled="@working">Reject</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (message != "")
            {
                <div class="notification">@message</div>
            }
        </main>
    }
</div>

@code {
    private Customer user = new Customer();
    private List<AdoptionRequest> requestsList = new List<AdoptionRequest>();

    private bool loaded = false;
    private bool working = false;
    private string message = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var res = await MySession.GetAsync<Customer>("customer");
        if (!res.Success || res.Value == null)
        {
            nav.NavigateTo("/login");
            return;
        }

        user = res.Value;
        await LoadRequests();

        loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadRequests()
    {
        AdoptionRequestDB db = new AdoptionRequestDB();
        requestsList = await db.GetRequestsForOwnerAsync(user.UserID);
    }

    private async Task ProcessRequest(int requestId, int petId, string newStatus)
    {
        working = true;
        message = "Processing...";

        try
        {
            AdoptionRequestDB db = new AdoptionRequestDB();
            await db.UpdateStatusAsync(requestId, newStatus);

            if (newStatus == "Approved")
            {
                PetsDB petDb = new PetsDB();
                await petDb.SetActiveAsync(petId, 0);
                message = "Adoption approved! Pet is no longer available.";
            }
            else
            {
                message = "Request rejected.";
            }

            await LoadRequests();
        }
        catch (Exception)
        {
            message = "An error occurred. Please try again.";
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoBack()
    {
        nav.NavigateTo("/myaccount");
    }
}

<style>
    .requests-container {
        display: flex;
        justify-content: center;
        min-height: 100vh;
        background-color: #f8faf9;
        padding: 40px 20px;
    }

    .content-card {
        width: 100%;
        max-width: 650px;
        background: white;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    header {
        text-align: center;
        margin-bottom: 30px;
    }

    .logo {
        color: #2e5f3e;
        margin: 0;
        font-size: 1.8rem;
    }

    header h3 {
        margin: 5px 0;
        color: #333;
    }

    header p {
        color: #777;
        font-size: 0.9rem;
    }

    .requests-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .request-item {
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #fdfdfd;
    }

    .request-info h4 {
        margin: 0 0 8px 0;
        color: #2e5f3e;
        font-size: 1.1rem;
    }

    .request-info p {
        margin: 4px 0;
        font-size: 0.9rem;
        color: #555;
    }

    .status-tag {
        font-weight: bold;
        color: #e67e22;
    }

    .request-actions {
        display: flex;
        gap: 10px;
    }

    .btn {
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-approve {
        background-color: #2e5f3e;
        color: white;
    }

    .btn-reject {
        background-color: #d93025;
        color: white;
    }

    .btn-back {
        background-color: #eee;
        color: #333;
        margin-top: 20px;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .notification {
        margin-top: 25px;
        padding: 12px;
        text-align: center;
        background-color: #eef5f0;
        color: #2e5f3e;
        border-radius: 8px;
        font-weight: bold;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #888;
    }

    @@media (max-width: 600px) {
        .request-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .request-actions {
            width: 100%;
        }

        .btn {
            flex: 1;
        }
    }
</style>