@page "/petdetails"
@using DBL
@using Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@inject ProtectedSessionStorage MySession
@inject NavigationManager nav
@inject HttpClient Http

<div class="details-page-wrapper">
    @if (!loaded)
    {
        <div class="loading-state">Loading pet information...</div>
    }
    else if (!string.IsNullOrEmpty(dbError))
    {
        <div class="error-container">
            <h3>System Error</h3>
            <p style="color: #d93025; font-weight: bold;">@dbError</p>
            <button class="btn btn-secondary" @onclick="GoBack">Back to Search</button>
        </div>
    }
    else if (pet == null)
    {
        <div class="error-container">
            <h3>Pet not found</h3>
            <button class="btn btn-secondary" @onclick="GoBack">Back to Search</button>
        </div>
    }
    else if (currentUser == null)
    {
        <div class="error-container" style="background: white; padding: 40px; border-radius: 20px; box-shadow: 0 8px 25px rgba(0,0,0,0.08);">
            <h3 style="color: #2e5f3e; margin-top: 0;">Login Required 🐾</h3>
            <p style="color: #555; font-size: 1.1rem; margin-bottom: 20px;">You need to be logged in to order a delivery for this pet.</p>
            <button class="btn-action-green" @onclick="GoToLogin" style="margin-bottom: 10px;">Go to Login</button>
            <br />
            <button class="btn-back-link" @onclick="GoBack">← Back to Search</button>
        </div>
    }
    else
    {
        <main class="details-card">
            <div class="image-container">
                <img class="pet-image" src="@GetImg(pet.PetPicture)" />
            </div>

            <div class="card-content">
                <header class="details-header">
                    <h2 class="pet-name">@pet.PetName</h2>
                    <div class="pet-type-info">
                        <span>@pet.TypeName</span> • <span>@pet.RaceName</span>
                    </div>
                </header>

                <div class="pet-quick-stats">
                    <div class="stat-item">
                        <span class="stat-label">Birth Year</span>
                        <span class="stat-value">@pet.PetBirthYear</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item">
                        <span class="stat-label">Location</span>
                        <span class="stat-value">@pet.PetAdress</span>
                    </div>
                </div>

                @if (currentUser.UserID == pet.UpdateUserID)
                {
                    <div class="status-box owner-box">
                        🐾 This is your pet!
                    </div>
                }
                else
                {
                    <section class="adoption-actions">
                        @if (!showDeliveryForm)
                        {
                            <button type="button" class="btn-action-blue" @onclick="ToggleDeliveryForm" disabled="@working">
                                🚚 Order Delivery Now
                            </button>
                        }

                        @if (showDeliveryForm)
                        {
                            <div class="delivery-form-box">
                                <h4>Order Delivery</h4>
                                <p style="font-size: 0.85rem; color: #666; margin-bottom: 15px;">
                                    Pickup: <b>@pet.PetAdress</b><br />
                                    Owner: <b>@pet.UploaderFirstName @pet.UploaderLastName</b>
                                </p>

                                <label>Your Delivery Address:</label>
                                <input type="text" @bind="deliveryAddress" placeholder="Enter destination address" class="form-control" />

                                <div style="display: flex; gap: 10px; margin-top: 15px;">
                                    <button type="button" class="btn-action-green" @onclick="SubmitDeliveryRequest" disabled="@working">
                                        Confirm Order
                                    </button>
                                    <button type="button" class="btn-action-cancel" @onclick="ToggleDeliveryForm" disabled="@working">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                    </section>
                }

                @if (statusMessage != "")
                {
                    <div class="status-box @(isErrorMsg ? "error-box" : "")">@statusMessage</div>
                }

                <section class="owner-contact">
                    <h4>Owner Information</h4>
                    <p class="owner-name">@pet.UploaderFirstName @pet.UploaderLastName</p>
                    <div class="contact-links">
                        <a href="mailto:@pet.UploaderEmail" class="contact-btn">Email</a>
                        <a href="tel:@pet.UploaderPhone" class="contact-btn">Call</a>
                    </div>
                </section>

                <button class="btn-back-link" @onclick="GoBack">← Back to Search</button>
            </div>
        </main>
    }
</div>

@code {
    private int PetID = 0;
    private Pet pet = null;
    private Customer currentUser = null;

    private bool loaded = false;
    private bool working = false;
    private string statusMessage = "";
    private bool isErrorMsg = false;
    private string dbError = "";

    private bool showDeliveryForm = false;
    private string deliveryAddress = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var userRes = await MySession.GetAsync<Customer>("customer");
            if (userRes.Success && userRes.Value != null)
            {
                currentUser = userRes.Value;
            }

            var petIdRes = await MySession.GetAsync<int>("selectedPetId");
            if (petIdRes.Success && petIdRes.Value > 0)
            {
                PetID = petIdRes.Value;
                PetsDB db = new PetsDB();
                pet = await db.GetByIdAsync(PetID);
            }
        }
        catch (Exception ex)
        {
            dbError = "Database Error: " + ex.Message;
        }
        finally
        {
            loaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleDeliveryForm()
    {
        showDeliveryForm = !showDeliveryForm;
        statusMessage = "";
    }

    private async Task SubmitDeliveryRequest()
    {
        if (string.IsNullOrWhiteSpace(deliveryAddress))
        {
            isErrorMsg = true;
            statusMessage = "Destination address is required.";
            return;
        }

        working = true;
        isErrorMsg = false;
        statusMessage = "Processing your order...";
        StateHasChanged();

        try
        {
            var deliveryData = new
            {
                SenderName = $"{pet.UploaderFirstName} {pet.UploaderLastName}",
                SenderPhone = pet.UploaderPhone,
                SenderEmail = pet.UploaderEmail,
                PickupAddress = pet.PetAdress,
                ReceiverName = $"{currentUser.FirstName} {currentUser.LastName}",
                ReceiverPhone = currentUser.Phone,
                ReceiverEmail = currentUser.Email,
                DeliveryAddress = deliveryAddress,
                PetDescription = $"{pet.PetName} ({pet.TypeName})",
                Status = "Pending"
            };

            string apiUrl = "https://localhost:7020/api/Deliveries/Create";

            var jsonContent = new StringContent(JsonSerializer.Serialize(deliveryData), Encoding.UTF8, "application/json");
            var response = await Http.PostAsync(apiUrl, jsonContent);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                using (JsonDocument doc = JsonDocument.Parse(responseContent))
                {
                    int trackingId = doc.RootElement.GetProperty("deliveryID").GetInt32();

                    PetsDB pdb = new PetsDB();
                    await pdb.SetActiveAsync(PetID, 0);

                    isErrorMsg = false;
                    statusMessage = $"Success! Your tracking number is: DLY-{trackingId}";
                    showDeliveryForm = false;
                }
            }
            else
            {
                isErrorMsg = true;
                string errorDetail = await response.Content.ReadAsStringAsync();
                statusMessage = "Order failed: " + errorDetail;
            }
        }
        catch (Exception ex)
        {
            isErrorMsg = true;
            statusMessage = "Connection error: " + ex.Message;
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoBack()
    {
        nav.NavigateTo("/");
    }

    private void GoToLogin()
    {
        nav.NavigateTo("/login");
    }

    private string GetImg(string pic) => string.IsNullOrEmpty(pic) ? "/PetPics/noimg.png" : "/PetPics/" + pic;
}

